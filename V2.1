  // =========================================================================
  // 7. GÖZ KIRPMA TETİKLEYİCİSİ (ASİMETRİ VE YARIM KIRPMA HESAPLARI)
  // =========================================================================
  void gozKirpTetikle() {
    if (kirpmaDurumu == 0) {
      kirpmaDurumu = 1; // Kapanma aşamasına geç
      kirpmaAsamaBaslangic = millis();
      solDriftOldu = false;
      sagDriftOldu = false;

      // Nadir göz kırpma olayı: Sadece normal veya kısık duygu durumundayken ve çoklu göz kırpma yokken %1.5 ihtimalle tek göz kırpma (wink) tetiklenir
      if ((mevcutDuygu == 0 || mevcutDuygu == 1) && kalanKirpmaSayisi == 0 && random(1000) < 15) {
        kirpmaTipi = random(1, 3); // 1: Sadece sol, 2: Sadece sağ (%50-50 şansla)
      } else {
        kirpmaTipi = 0; // 0: Çift göz kırpma
      }

      // Kapanma sonrası kapalı kalma bekleme süresi
      if (kirpmaTipi == 0 && random(100) < 5) {
        kirpmaDuraklamaSuresi = random(300, 601);
      } else {
        kirpmaDuraklamaSuresi = random(10, 31);
      }

      // Duyguya Göre Dinamik Kas Hızı
      if (mevcutDuygu == 2 || mevcutDuygu == 3) { // ŞAŞKIN veya KIZGIN
        kapanmaSuresi = random(75, 110); 
      } else if (mevcutDuygu == 1) { // KISIK
        kapanmaSuresi = random(160, 240); 
      } else { // NORMAL
        kapanmaSuresi = random(95, 150); 
      }
      acilmaSuresi = kapanmaSuresi * 2; // Açılma süresi kesinlikle kapanmanın 2 katı

      // Ardışık Kırpmada İkinci Adım Kusursuzluğu
      if (kalanKirpmaSayisi > 0) {
        limitDikeyKirpma = 1;
      } else {
        // Yarım Kırpma Kontrolü: %25 ihtimalle gözler tam kapanmaz
        if (random(100) < 25) {
          limitDikeyKirpma = random(12, 18);
        } else {
          limitDikeyKirpma = 1;
        }
      }

      // Milisaniyelik Asimetrik Kırpma: Sol ve sağ göz arasında 3-8 ms arası rastgele bir gecikme yaratılır
      int gecikme = random(3, 9);
      if (random(2) == 0) {
        solGozKirpmaGecikmesi = gecikme;
        sagGozKirpmaGecikmesi = 0;
      } else {
        solGozKirpmaGecikmesi = 0;
        sagGozKirpmaGecikmesi = gecikme;
      }

      // Mevcut dikey boyutları kırpma öncesi hafızaya al
      solGoz.kirpmaEskiDikey = solGoz.hedefDikey;
      sagGoz.kirpmaEskiDikey = sagGoz.hedefDikey; 

      kisilarakHedefDegisiyor = true;
    }
  }

  // =========================================================================
  // 8. ODAK VE DUYGUYA GÖRE HEDEF ŞEKİL GÜNCELLEMELERİ
  // =========================================================================
  void gozHedefleriniGuncelle() {
    // Organik asimetri için gözler arasında maksimum 1 piksellik küçük boyut farkları (V1.8: Dengeleme)
    int solRastgeleD = random(-1, 2); 
    int solRastgeleY = random(-1, 2); 
    int sagRastgeleD = random(-1, 2); 
    int sagRastgeleY = random(-1, 2);

    int constrainedOrtakX = constrain(ortakhedefX, 32, 96);
    int constrainedOrtakY = constrain(ortakhedefY, 5, 35);

    // Gözün ekrandaki pozisyonuna göre odak derinliği offseti hesaplanır.
    int dx_abs = abs(constrainedOrtakX - 64);
    int dy_signed = constrainedOrtakY - 32;
    int dy_abs = abs(dy_signed);
    int dist = (dx_abs > dy_abs) ? (dx_abs + (dy_abs * 2) / 5) : (dy_abs + (dx_abs * 2) / 5);
    int odakOffset = (dist * 7) / 90 - 1; 

    // Kapak-Bebek Koordinasyonu: Göz yukarı bakınca kapaklar açılır, aşağı bakınca kısılır (Daha Belirgin).
    int bakisDikeyOffset = (dy_signed * -11) / 50;

    // Odaklanma Derinliğine Göre Yakınsama (Vergence): Ekran ortasına (64) yaklaştıkça göz aralığı daralır.
    int merkezSapmaX = abs(constrainedOrtakX - 64);
    int vergenceOffset = (merkezSapmaX * 3) / 32 - 3; // Ortadayken -3px içe kayar, kenarlardayken 0px (dışa açılmaz, dengeli kalır).

    switch (mevcutDuygu) {
      case 0: { // --- NORMAL DUYGU ---
        int tSolY = 21 + solRastgeleY + odakOffset;
        solGoz.hedefYatay = tSolY > 10 ? tSolY : 10;
        int tSolD = 32 + solRastgeleD + odakOffset + bakisDikeyOffset;
        solGoz.hedefDikey = tSolD > 10 ? tSolD : 10;
        int tSagY = 21 + sagRastgeleY + odakOffset;
        sagGoz.hedefYatay = tSagY > 10 ? tSagY : 10;
        int tSagD = 32 + sagRastgeleD + odakOffset + bakisDikeyOffset;
        sagGoz.hedefDikey = tSagD > 10 ? tSagD : 10;
        gozAraligi = random(19, 26) + vergenceOffset; 
        break;
      }

      case 1: { // --- KISIK / YORGUN DUYGU ---
        int tSolY = 21 + solRastgeleY + odakOffset / 2;
        solGoz.hedefYatay = tSolY > 10 ? tSolY : 10;
        int tSolD = 16 + solRastgeleD + odakOffset / 2 + bakisDikeyOffset / 2;
        solGoz.hedefDikey = tSolD > 8 ? tSolD : 8;
        int tSagY = 21 + sagRastgeleY + odakOffset / 2;
        sagGoz.hedefYatay = tSagY > 10 ? tSagY : 10;
        int tSagD = 16 + sagRastgeleD + odakOffset / 2 + bakisDikeyOffset / 2;
        sagGoz.hedefDikey = tSagD > 8 ? tSagD : 8;
        gozAraligi = random(19, 26) + vergenceOffset; 
        break;
      }

      case 2: { // --- ŞAŞKIN DUYGU ---
        int tSolY = 32 + solRastgeleY + odakOffset;
        solGoz.hedefYatay = tSolY > 15 ? tSolY : 15;
        int tSolD = 42 + solRastgeleD + odakOffset + bakisDikeyOffset;
        solGoz.hedefDikey = tSolD > 20 ? tSolD : 20;
        int tSagY = 32 + sagRastgeleY + odakOffset;
        sagGoz.hedefYatay = tSagY > 15 ? tSagY : 15;
        int tSagD = 42 + sagRastgeleD + odakOffset + bakisDikeyOffset;
        sagGoz.hedefDikey = tSagD > 20 ? tSagD : 20;
        gozAraligi = random(24, 28) + vergenceOffset; 
        break;
      }

      case 3: { // --- KIZGIN DUYGU ---
        solGoz.hedefYatay = 28 + solRastgeleY;  
        int tSolD = 22 + solRastgeleD + bakisDikeyOffset / 2;
        solGoz.hedefDikey = tSolD > 12 ? tSolD : 12;
        sagGoz.hedefYatay = 28 + sagRastgeleY;  
        int tSagD = 22 + sagRastgeleD + bakisDikeyOffset / 2;
        sagGoz.hedefDikey = tSagD > 12 ? tSagD : 12;
        gozAraligi = random(17, 20) + vergenceOffset; 
        break;
      }
    }
  }

  // =========================================================================
  // 9. AĞIRLIKLI RASGELE DUYGU SEÇİMİ
  // =========================================================================
  byte duyguSec() {
    bool ortada = (ortakhedefX >= 54 && ortakhedefX <= 74) && 
                  (ortakhedefY >= 12 && ortakhedefY <= 28);

    int normalAgirlik = ortada ? 900 : 920;
    int kizginAgirlik = ortada ? 75 : 2;
    int kismaAgirlik  = ortada ? 10 : 30;
    int saskinAgirlik = ortada ? 5 : 15;

    int toplamNormal = normalAgirlik;
    
    int toplamKisma = kismaAgirlik + (int)kismaEtkisi;
    if (toplamKisma < 0) toplamKisma = 0;

    int toplamKizgin = kizginAgirlik + (int)kizginEtkisi;
    if (toplamKizgin < 0) toplamKizgin = 0;

    int toplamSaskin = saskinAgirlik + (int)saskinEtkisi;
    if (toplamSaskin < 0) toplamSaskin = 0;

    int toplamHavuz = toplamNormal + toplamKisma + toplamKizgin + toplamSaskin;
    if (toplamHavuz <= 0) toplamHavuz = 1; 

    int r = random(toplamHavuz);

    if (r < toplamNormal) return 0; // NORMAL
    else if (r < toplamNormal + toplamKisma) return 1; // KISMA
    else if (r < toplamNormal + toplamKisma + toplamSaskin) return 2; // ŞAŞKIN
    else return 3; // KIZGIN
  }

  uint16_t getCustomCharPattern(char c) {
    switch (c) {
      case 'G': return 31087;
      case 'O': return 31599;
      case 'Z': return 29351;
      case 'P': return 31716;
      case 'R': return 31661;
      case 'J': return 4719;
      case 'E': return 31207;
      case 'S': return 31183;
      case '5': return 31183;
      case 'I': return 29975;
      case 'V': return 23402;
      case '1': return 11415;
      case '2': return 29671; // V2 için '2' deseni (5x3 piksel)
      case '9': return 31695;
      case '.': return 2;
      default: return 0;
    }
  }

  void drawCustomChar(int16_t x, int16_t y, char c, uint8_t size) {
    uint16_t pattern = getCustomCharPattern(c);
    if (pattern == 0 && c != ' ') return;
    
    for (uint8_t row = 0; row < 5; row++) {
      for (uint8_t col = 0; col < 3; col++) {
        uint8_t bitIndex = 14 - (row * 3 + col);
        if ((pattern >> bitIndex) & 1) {
          display.fillRect(x + col * size, y + row * size, size, size, SSD1306_WHITE);
        }
      }
    }
  }

  void drawCustomString(int16_t x, int16_t y, const char* str, uint8_t size) {
    while (*str) {
      drawCustomChar(x, y, *str, size);
      x += size * 4; // 3 sütun + 1 boşluk = 4 * size
      str++;
    }
  }

  void showLogo() {
    display.clearDisplay();
    display.drawRect(2, 2, 124, 60, SSD1306_WHITE);
    drawCustomString(53, 10, "GOZ", 2);
    drawCustomString(37, 26, "PROJESI", 2);
    display.drawFastHLine(34, 42, 60, SSD1306_WHITE);
    drawCustomString(56, 46, "V2.1", 1);
    display.display();
  }

